# ============================================================
# Discord Bot Dashboard — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# The public URL of this Next.js dashboard deployment.
# Must match the redirect URI registered in the Discord Developer Portal.
NEXTAUTH_URL=https://dashboard-production-f985.up.railway.app

# A long random secret used to sign session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Discord OAuth2 application credentials.
# Create an application at https://discord.com/developers/applications
# Add the following Redirect URI in OAuth2 settings:
#   https://dashboard-production-f985.up.railway.app/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL of the Express API backend (used for guild management features).
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# Bot invite URL (used for "Add to Server" buttons).
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=YOUR_BOT_CLIENT_ID&permissions=8&scope=bot%20applications.commands

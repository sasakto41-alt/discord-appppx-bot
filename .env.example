# ══════════════════════════════════
# Discord Bot Configuration
# ══════════════════════════════════
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_BOT_PREFIX=!

# ══════════════════════════════════
# Database
# ══════════════════════════════════
DATABASE_URL=mongodb://localhost:27017/discord-bot
REDIS_URL=redis://localhost:6379

# ══════════════════════════════════
# API Configuration
# ══════════════════════════════════
API_PORT=3001
API_SECRET=your_api_secret_key
JWT_SECRET=your_jwt_secret

# ══════════════════════════════════
# Dashboard Configuration
# ══════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# ══════════════════════════════════
# OAuth2
# ══════════════════════════════════
DISCORD_OAUTH2_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# ══════════════════════════════════
# OpenAI (для AI модерации)
# ══════════════════════════════════
OPENAI_API_KEY=your_openai_api_key

# ══════════════════════════════════
# Music (Lavalink)
# ══════════════════════════════════
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
